##################################################
functional_acf <- function(X, lag_max) {
X <- scale(X, center = TRUE, scale = FALSE)
denom <- sum(X^2)
rho <- sapply(1:lag_max, function(h) {
sum(X[1:(nrow(X) - h), ] *
X[(h + 1):nrow(X), ]) / denom
})
return(rho)
}
lag_max <- 20
rho_fun <- functional_acf(pre_smoothing, lag_max = lag_max)
# Approximate reference bounds under white noise
n_obs <- nrow(pre_smoothing)
acf_bound <- 1.96 / sqrt(n_obs)
pdf("Sydney_functional_ACF.pdf", width = 5, height = 4)
plot(
1:lag_max,
rho_fun,
type = "h",
lwd = 2,
xlab = "Lag",
ylab = "Functional autocorrelation",
main = "",
ylim = range(c(rho_fun, -acf_bound, acf_bound))
)
points(1:lag_max, rho_fun, pch = 16)
abline(h = 0, lty = 1)
abline(h = acf_bound, lty = 2)
abline(h = -acf_bound, lty = 2)
dev.off()
print(round(rho_fun, 3))
cat("Approximate reference bounds: ±", round(acf_bound, 3), "\n")
