setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
rm(list = ls( ))
library(scatterplot3d)
library(plotly)
library(splines)
library(rgl)
library(MASS)
df = read.csv('temperature_data.csv')
Y = as.matrix(df[,2:366])
n <- nrow(Y)
N <- ncol(Y)
par(lwd = 0.1)
idx <- seq(1960, 2008, by = 10)
k   <- length(idx)
cols <- colorRampPalette(c("blue4", "deepskyblue"))(k)
s3d <- scatterplot3d(
x = rep(idx[1], N),
y = 1:N,
z = Y[idx[1]-1959+1,],
type = "l",
color = cols[1],
box = FALSE,
grid = FALSE,
xlim = c(1959,2008),
ylim = c(1,365),
zlim = c(10,40),
ylab = 'Day',xlab = 'Year',zlab = 'Temperature'
)
for(j in 2:k){
i <- idx[j]
s3d$points3d(
x = rep(i, N),
y = 1:N,
z = Y[i-1959+1, ],
type = "l",
col = cols[j]
)
}
set.seed(123)
N = ncol(Y)
n = nrow(Y);n
J_N = 0
p_N = 4
J_T = 0
p_T = 4
lattice = seq(1/N,1,1/N)
knotsN = seq(0,1,length=J_N+2)
B_N = bs(lattice,knots=knotsN[-c(1,(J_N+2))],degree=p_N-1,intercept=TRUE,Boundary.knots=knotsN[c(1,(J_N+2))])
lattice_time = seq(1/n,1,1/n)
knotsT = seq(0,1,length=J_T+2)
B_T = bs(lattice_time,knots=knotsT[-c(1,(J_T+2))],degree=p_T-1,intercept=TRUE,Boundary.knots=knotsT[c(1,(J_T+2))])
B = kronecker(B_T,B_N)
V = solve(t(B)%*%B)
a1 = t(B)%*% c(t(Y))
a2 = V %*% a1
a3 = B %*% a2
N0 = 50
lattice.eval = seq(1/N0,1,1/N0)
B_N.eval = bs(lattice.eval,knots=knotsN[-c(1,(J_N+2))],degree=p_N-1,intercept=TRUE,Boundary.knots=knotsN[c(1,(J_N+2))])
B_T.eval = bs(lattice.eval,knots=knotsT[-c(1,(J_T+2))],degree=p_T-1,intercept=TRUE,Boundary.knots=knotsT[c(1,(J_T+2))])
B_N.eval = B_N
B_T.eval = B_T
B.eval = kronecker(B_T.eval,B_N.eval)
m_hat.eval =  matrix(B.eval%*%a2,n,N,T)
m_hat =  matrix(a3,n,N,T)
persp3d(m_hat,col='blue')
trajectory_coef = solve(t(B_N)%*%B_N)%*%t(B_N)%*%t(Y)
pre_smoothing = t(sapply(1:n, function(t,B_T,B_N,trajectory_coef,a2){
B_t =  matrix(B_T[t,],1)
return(B_N%*%trajectory_coef[,t]-kronecker(B_t,B_N) %*% a2)
},B_T,B_N,trajectory_coef,a2))
# pre_smoothing[t, ] is the estimated residual curve xi_t(x)
xi_hat <- pre_smoothing
# Remove any small remaining empirical mean function
xi_hat <- sweep(
xi_hat,
2,
colMeans(xi_hat),
FUN = "-"
)
# Inner product approximating integral_0^1 f(x)g(x) dx
functional_inner_product <- function(f, g) {
mean(f * g)
}
# lag-0 covariance
gamma0 <- mean(
sapply(1:n, function(t) {
functional_inner_product(xi_hat[t, ], xi_hat[t, ])
})
)
# Maximum lag considered
lag_max <- 10
# Functional lag-h covariance
gamma_h <- sapply(1:lag_max, function(h) {
mean(
sapply(1:(n - h), function(t) {
functional_inner_product(
xi_hat[t, ],
xi_hat[t + h, ]
)
})
)
})
# Functional lag-h correlation
rho_h <- gamma_h / gamma0
# Display results
functional_acf_result <- data.frame(
Lag = 1:lag_max,
Correlation = rho_h
)
print(functional_acf_result)
write.csv(
functional_acf_result,
"Sydney_functional_lag_correlation.csv",
row.names = FALSE
)
##############################################################
## Plot functional lag-h correlations
##############################################################
pdf(
"Sydney_functional_lag_correlation.pdf",
width = 5.5,
height = 4.5
)
plot(
1:lag_max,
rho_h,
type = "h",
lwd = 2,
ylim = range(c(0, rho_h)),
xlab = "Lag",
ylab = "Functional correlation",
xaxt = "n"
)
axis(1, at = 1:lag_max)
points(
1:lag_max,
rho_h,
pch = 16
)
abline(
h = 0,
lty = 2
)
dev.off()
functional_acf <- function(X, lag_max = 10) {
X <- scale(X, center = TRUE, scale = FALSE)
denom <- sum(X^2)
rho <- sapply(1:lag_max, function(h) {
sum(X[1:(nrow(X) - h), ] *
X[(h + 1):nrow(X), ]) / denom
})
return(rho)
}
rho_fun <- functional_acf(xi_hat, lag_max)
pdf("Sydney_functional_ACF.pdf", width = 5, height = 4)
plot(
1:lag_max,
rho_fun,
type = "h",
lwd = 2,
xlab = "Lag",
ylab = "Functional autocorrelation",
main = ""
)
points(1:lag_max, rho_fun, pch = 16)
abline(h = 0, lty = 1)
dev.off()
print(round(rho_fun, 3))
