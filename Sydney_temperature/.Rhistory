##############################################################
## Exploratory analysis of temporal dependence:
## ACFs of the estimated FPC scores of detrended curves
##############################################################
# pre_smoothing[t, ] = estimated xi_t(x)
# Remove the small remaining empirical mean before FPCA
xi_hat <- scale(pre_smoothing, center = TRUE, scale = FALSE)
# Empirical FPCA.
# Since the functional grid is equally spaced, ordinary PCA gives
# the same eigenfunctions/scores up to a constant scaling factor,
# which does not affect the ACF.
fpca_fit <- prcomp(xi_hat, center = FALSE, scale. = FALSE)
# Estimated FPC scores
fpc_scores <- fpca_fit$x
# Proportion of variance explained
var_explained <- fpca_fit$sdev^2 / sum(fpca_fit$sdev^2)
cat("Variance explained by the first three FPCs:\n")
print(round(var_explained[1:3], 4))
# Plot ACFs of the first three estimated FPC score series
K_acf <- 3
lag_max <- min(10, n - 1)
pdf("Sydney_FPC_score_ACF.pdf", width = 10, height = 3.5)
old_par <- par(
mfrow = c(1, K_acf),
mar = c(4, 4, 2.5, 1),
lwd = 1
)
for (k in 1:K_acf) {
acf(
fpc_scores[, k],
lag.max = lag_max,
main = paste0("FPC ", k),
xlab = "Lag",
ylab = "ACF"
)
}
par(old_par)
dev.off()
lag_max=20
functional_acf <- function(X, lag_max) {
X <- scale(X, center = TRUE, scale = FALSE)
denom <- sum(X^2)
rho <- sapply(1:lag_max, function(h) {
sum(X[1:(nrow(X) - h), ] *
X[(h + 1):nrow(X), ]) / denom
})
return(rho)
}
rho_fun <- functional_acf(Y, lag_max)
pdf("Sydney_functional_ACF.pdf", width = 5, height = 4)
plot(
1:lag_max,
rho_fun,
type = "h",
lwd = 2,
