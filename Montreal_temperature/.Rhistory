library(MASS)
library(splines)
library(rgl)
library(stringr)
Y = MontrealTemp
set.seed(123)
N = ncol(Y);N
n = nrow(Y);n
J_N = 4
p_N = 4
J_T = 0
p_T = 4
lattice = seq(1/N,1,1/N)
knotsN = seq(0,1,length=J_N+2)
B_N = bs(lattice,knots=knotsN[-c(1,(J_N+2))],degree=p_N-1,intercept=TRUE,Boundary.knots=knotsN[c(1,(J_N+2))])
lattice_time = seq(1/n,1,1/n)
knotsT = seq(0,1,length=J_T+2)
B_T = bs(lattice_time,knots=knotsT[-c(1,(J_T+2))],degree=p_T-1,intercept=TRUE,Boundary.knots=knotsT[c(1,(J_T+2))])
B = kronecker(B_T,B_N)
V = solve(t(B)%*%B)
a1 = t(B)%*% c(t(Y))
a2 = V %*% a1
a3 = B %*% a2
B_N.eval = B_N
B_T.eval = B_T
B.eval = kronecker(B_T.eval,B_N.eval)
m_hat.eval =  matrix(B.eval%*%a2,n,N,T)
m_hat =  matrix(a3,n,N,T)
persp3d(m_hat,col='blue')
trajectory_coef = solve(t(B_N)%*%B_N)%*%t(B_N)%*%t(Y)
pre_smoothing = t(sapply(1:n, function(t,B_T,B_N,trajectory_coef,a2){
B_t =  matrix(B_T[t,],1)
return(B_N%*%trajectory_coef[,t]-kronecker(B_t,B_N) %*% a2)
},B_T,B_N,trajectory_coef,a2))
calculate_ans <- function(BB) {
L = floor(n/BB)
ans = matrix(0, N, N)
for (l in 1:L) {
start_index = 1 + (l-1) * BB
end_index = l * BB
ans = ans + colMeans(pre_smoothing[start_index:end_index,]) %*%
t(colMeans(pre_smoothing[start_index:end_index,]))
}
ans = ans * BB/L
return(ans)
}
BB_values = min(2,floor(n^(1/5))): ceiling(n^(1/5)*log(n))
ans_values = lapply(BB_values, calculate_ans)
best_BB_index = which.max(sapply(ans_values, function(x) mean(diag(x))))
best_BB = BB_values[best_BB_index]
ans = ans_values[[best_BB_index]]
##############################################################
b1 = t(B_N)%*% ans %*%B_N/N^2
V_N = t(B_N)%*%B_N/N
b2 = solve(V_N)%*% b1 %*%  solve(V_N)
V_T = t(B_T)%*%B_T/n
Sigma = kronecker(solve(V_T),b2)
diag_sd =  sqrt(diag(B.eval%*%Sigma%*%t(B.eval)))
Our_bootstrap = mvrnorm(1000,rep(0,ncol(Sigma)),Sigma)
Our_result = B.eval%*%t(Our_bootstrap)/diag_sd
alpha = 0.05
Q = quantile(apply(abs(Our_result),2,max),1-alpha);Q
adjustfactor = 1 + 20/n
persp3d(m_hat.eval,zlim=c(-30,30), col = "red", shade = 0.5)
persp3d(m_hat.eval+adjustfactor*Q*matrix(diag_sd,n,N,T)/sqrt(n ) ,zlim=c(-30,30),shade = 0.5)
persp3d(m_hat.eval-adjustfactor*Q*matrix(diag_sd,n,N,T)/sqrt(n ) ,zlim=c(-30,30), shade = 0.5)
write.csv(m_hat.eval,'z1.csv')
write.csv(m_hat.eval+adjustfactor*Q*matrix(diag_sd,n,N,T)/sqrt(n ),'z2.csv')
write.csv(m_hat.eval-adjustfactor*Q*matrix(diag_sd,n,N,T)/sqrt(n ),'z3.csv')
#####################
############################################################
# Corrected time-invariance test based on Appendix F
############################################################
# Number of Gaussian simulations
B_boot = 5000
set.seed(123)
############################################################
# Step 1: estimate the unknown time-invariant mean m_0(x)
#
# Appendix F:
#   m_hat_0(x) = T^{-1} sum_t eta_hat_t(x)
#
# By linearity of the spline smoother this is identical to
# smoothing the cross-sectional average observations.
############################################################
m0_vec =
B_N %*%
solve(t(B_N) %*% B_N) %*%
t(B_N) %*%
colMeans(Y)
m0_vec = as.vector(m0_vec)
# Create the time-invariant surface
m0 =
matrix(
rep(m0_vec, n),
nrow = n,
ncol = N,
byrow = TRUE
)
############################################################
# Optional numerical check:
#
# Appendix F shows that m_hat_0(x) also equals
# T^{-1} sum_t m_hat(t/T,x)
############################################################
cat(
"Difference between the two representations of m0:",
max(abs(m0_vec - colMeans(m_hat))),
"\n"
)
############################################################
# Step 2: centered temporal B-spline basis
#
# B_T^c(tau) = B_T(tau) - bar{B}_T
#
# bar{B}_T = T^{-1} sum_t B_T(t/T)
############################################################
B_T_bar = colMeans(B_T)
B_T_center =
sweep(
B_T,
MARGIN = 2,
STATS = B_T_bar,
FUN = "-"
)
############################################################
# Tensor-product centered basis
#
# This generates the covariance structure of
#
#   Z_tilde_T(tau,x)
#     = Z_T(tau,x)
#       - T^{-1} sum_t Z_T(t/T,x)
############################################################
B_center =
kronecker(
B_T_center,
B_N
)
############################################################
# Step 3: estimated variance of the centered Gaussian process
#
# Sigma has already been constructed above as
#
#   solve(V_T) \otimes Gamma_hat
#
# Do NOT form
# B_center %*% Sigma %*% t(B_center)
# explicitly, since this is a huge matrix.
############################################################
B_center_Sigma =
B_center %*% Sigma
diag_var_center =
rowSums(
B_center_Sigma * B_center
)
# Protect against tiny negative values caused by numerical precision
diag_var_center =
pmax(diag_var_center, 0)
diag_sd_center =
sqrt(diag_var_center)
cat(
"Minimum centered SD:",
min(diag_sd_center),
"\n"
)
############################################################
# Step 4: observed corrected test statistic
#
# With the normalization in the current code,
#
# diag_sd_center / sqrt(n)
#
# is the standard error of
# m_hat(tau,x) - m_hat_0(x).
############################################################
difference_surface =
m_hat - m0
difference_vec =
c(t(difference_surface))
se_center_vec =
diag_sd_center / sqrt(n)
test_stat =
max(
abs(difference_vec / se_center_vec)
)
cat(
"Corrected time-invariance test statistic:",
test_stat,
"\n"
)
############################################################
# Step 5: simulate the centered Gaussian process
############################################################
Gaussian_coef =
mvrnorm(
B_boot,
mu = rep(0, ncol(Sigma)),
Sigma = Sigma
)
# Each column is one simulated centered Gaussian surface
Z_center =
B_center %*% t(Gaussian_coef)
# Studentize pointwise
Z_center_std =
sweep(
Z_center,
MARGIN = 1,
STATS = diag_sd_center,
FUN = "/"
)
# Supremum statistic for each Gaussian replication
bootstrap_stat =
apply(
abs(Z_center_std),
2,
max
)
############################################################
# Step 6: critical values and Monte Carlo p-value
############################################################
Q_90 = as.numeric(quantile(bootstrap_stat, 0.90))
Q_95 = as.numeric(quantile(bootstrap_stat, 0.95))
Q_99 = as.numeric(quantile(bootstrap_stat, 0.99))
cat("\n")
cat("Corrected time-invariance test\n")
cat("------------------------------------\n")
cat("Test statistic =", test_stat, "\n")
cat("90% critical value =", Q_90, "\n")
cat("adjusted 90% critical value =", adjustfactor * Q_90, "\n")
cat("95% critical value =", Q_95, "\n")
cat("99% critical value =", Q_99, "\n")
cat("adjusted 99% critical value =", adjustfactor * Q_99, "\n")
cat("------------------------------------\n")
cat(
"Reject at 10% level:",
test_stat > adjustfactor * Q_90,
"\n"
)
cat(
"Reject at 1% level:",
test_stat > adjustfactor * Q_99,
"\n"
)
